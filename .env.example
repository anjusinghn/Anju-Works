# Every variable is optional. Without one, its widget renders labeled sample
# data from config/sample/.

# GitHub token: live contribution calendar, and authenticated star count requests
GITHUB_TOKEN=

# Discord user id for the footer presence card (via Lanyard)
DISCORD_USER_ID=

# Talvess Stats API: live Insights chart and footer visitor counter
TALVESS_STATS_KEY=
TALVESS_ORIGIN=https://talvess.app

# Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
