---
import GitHubActivity from "@/components/GitHubActivity.astro";
import ProjectExplorer from "@/components/ProjectExplorer.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { certifications, experience, highlights, profile, skills } from "@/data/profile";
import Layout from "@/layouts/Layout.astro";

const sections = [
  { id: "intro", label: "Top" },
  { id: "projects", label: "Work" },
  { id: "experience", label: "Experience" },
  { id: "about", label: "About" },
  { id: "github", label: "GitHub" },
  { id: "contact", label: "Contact" },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: Astro.site?.href,
  image: new URL("/anju-singh.webp", Astro.site).href,
  description: profile.description,
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: ["AI automation", "Full-stack development", "Developer tools", "Python", "React"],
};
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <main id="main" class="shell portfolio" tabindex="-1">
    <section id="intro" class="hero" aria-labelledby="intro-heading">
      <div class="hero-banner">
        <img src="/contours.webp" width="1320" height="394" alt="" fetchpriority="high" />
      </div>
      <div class="hero-content">
        <img class="portrait" src="/anju-singh.webp" alt="Anju Singh" width="750" height="900" fetchpriority="high" />
        <p class="eyebrow">AI &amp; software engineering</p>
        <h1 id="intro-heading">{profile.name}<span>.</span></h1>
        <p class="intro">I build AI assistants, automation workflows, and developer tools. I’m studying computer science and engineering at <span class="nowrap">VIT-AP</span>.</p>
        <div class="hero-actions">
          <a class="button primary" href="#projects">View work <span aria-hidden="true">↓</span></a>
          <a class="button" href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>
          <a class="button" href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <ProjectExplorer />

    <section id="experience" class="section" aria-labelledby="experience-heading">
      <div class="section-heading">
        <h2 id="experience-heading">Experience</h2>
        <a class="text-link" href={profile.resume} download>Download résumé <span aria-hidden="true">↓</span></a>
      </div>
      <ol class="timeline" role="list">
        {experience.map(({ role, company, dates, location, highlights }) => (
          <li class="experience-item">
            <div class="experience-meta"><span>{dates}</span><span>{location}</span></div>
            <div>
              <h3>{role}</h3>
              <p class="company">{company}</p>
              <ul class="detail-list">{highlights.map((highlight) => <li>{highlight}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="about" class="section" aria-labelledby="about-heading">
      <div class="section-heading"><h2 id="about-heading">About</h2></div>
      <div class="about-grid">
        <div class="about-background">
          <div>
            <h3>Education</h3>
            <p class="school">Vellore Institute of Technology (VIT-AP)</p>
            <p>B.Tech in Computer Science and Engineering</p>
            <p class="secondary">Aug 2023 – May 2027 · CGPA 8.80/10</p>
          </div>
          <div>
            <h3>Certifications</h3>
            <ul class="detail-list">{certifications.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div>
            <h3>Beyond coursework</h3>
            <ul class="detail-list">{highlights.map((item) => <li>{item}</li>)}</ul>
          </div>
        </div>
        <div class="skills-panel">
          <h3>Technical skills</h3>
          <dl>
            {skills.map(({ area, technologies }) => <div><dt>{area}</dt><dd>{technologies}</dd></div>)}
          </dl>
        </div>
      </div>
    </section>

    <GitHubActivity />

    <footer id="contact" class="section site-footer" aria-labelledby="contact-heading">
      <div>
        <h2 id="contact-heading">Let’s get in touch.</h2>
        <a class="text-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
      </div>
      <SocialLinks />
    </footer>
  </main>

  <nav class="section-rail" aria-label="On this page">
    {sections.map(({ id, label }) => <a href={`#${id}`}><span aria-hidden="true"></span>{label}</a>)}
  </nav>
</Layout>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".section-rail a"));
  const sections = links.flatMap((link) => {
    const element = document.getElementById(link.hash.slice(1));
    return element ? [{ element, link }] : [];
  });

  function updateSection() {
    const reachedBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    const current = reachedBottom
      ? sections.at(-1)
      : sections.findLast(({ element }) => element.getBoundingClientRect().top <= 145) ?? sections[0];

    for (const section of sections) {
      if (section === current) section.link.setAttribute("aria-current", "location");
      else section.link.removeAttribute("aria-current");
    }
  }

  let frame = 0;
  window.addEventListener("scroll", () => {
    if (frame) return;
    frame = requestAnimationFrame(() => {
      updateSection();
      frame = 0;
    });
  }, { passive: true });
  window.addEventListener("resize", updateSection);
  updateSection();
</script>
