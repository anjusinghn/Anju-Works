---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { certifications, experience, highlights, profile, skills } from "@/data/profile";
import { projects } from "@/data/projects";
---

<Layout>
  <main id="main">
    <section class="hero shell" aria-labelledby="intro">
      <div class="hero-content">
        <p class="eyebrow hero-focus">{profile.focus}</p>
        <h1 id="intro">{profile.name}</h1>
        <p class="hero-intro">
          I build AI assistants, automation workflows, and full-stack tools. I’m studying computer
          science and engineering at VIT-AP.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#projects">
            View projects <span aria-hidden="true">↓</span>
          </a>
          <a class="button button-secondary" href="#contact">
            Get in touch <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="portrait-frame">
        <img
          class="portrait"
          src="/anju-singh.webp"
          alt="Anju Singh beside a lake at sunset"
          width="750"
          height="900"
          fetchpriority="high"
        />
      </div>
    </section>

    <section id="projects" class="shell section" aria-labelledby="projects-heading">
      <div class="section-heading">
        <h2 id="projects-heading">Selected projects</h2>
        <a class="text-link" href={profile.github + "?tab=repositories"}>
          All GitHub repositories <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard {project} featured={index === 0} />)}
      </div>
    </section>

    <section id="experience" class="experience-section" aria-labelledby="experience-heading">
      <div class="shell section">
        <h2 id="experience-heading">Experience</h2>
        <div class="experience-list">
          {
            experience.map(({ role, company, dates, location, highlights }) => (
              <article class="experience-item">
                <div class="experience-meta">
                  <p class="experience-dates">{dates}</p>
                  <p>{location}</p>
                </div>
                <div>
                  <h3>{role}</h3>
                  <p class="experience-company">{company}</p>
                  <ul class="detail-list">
                    {highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="about" class="shell section" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      <div class="about-grid">
        <div class="about-background">
          <div>
            <h3>Education</h3>
            <p class="school">Vellore Institute of Technology (VIT-AP), Amaravati</p>
            <p>B.Tech in Computer Science and Engineering</p>
            <p class="education-meta">Aug 2023 – May 2027 <span aria-hidden="true">·</span> CGPA 8.80/10</p>
          </div>

          <div>
            <h3>Certifications</h3>
            <ul class="detail-list">
              {certifications.map((certification) => <li>{certification}</li>)}
            </ul>
          </div>

          <div>
            <h3>Activities & achievements</h3>
            <ul class="detail-list">
              {highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </div>

        <div class="skills-panel">
          <h3>Technical skills</h3>
          <dl class="skills-list">
            {
              skills.map(({ area, technologies }) => (
                <div>
                  <dt>{area}</dt>
                  <dd>{technologies}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>
  </main>

  <footer id="contact" class="site-footer" aria-labelledby="contact-heading">
    <div class="shell footer-inner">
      <div>
        <h2 id="contact-heading">Get in touch</h2>
        <a class="email-link" href={"mailto:" + profile.email}>
          {profile.email} <span aria-hidden="true">↗</span>
        </a>
      </div>
      <SocialLinks />
    </div>
  </footer>
</Layout>
