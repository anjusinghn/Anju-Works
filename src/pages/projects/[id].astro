---
import Layout from "@/layouts/Layout.astro";
import { projects } from "@/data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Anju Singh`} description={project.description}>
  <main class="shell case-study" id="main" tabindex="-1">
    <header class="section case-header">
      <a class="text-link back-link" href="/#projects"><span aria-hidden="true">←</span> Selected work</a>
      <p class="eyebrow">{project.category}</p>
      <h1>{project.title}</h1>
      <p class="intro">{project.description}</p>
      <ul class="tags" aria-label="Technologies" role="list">
        {project.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
      <div class="project-links">
        {project.repositories.map(({ label, url }) => (
          <a class="button" href={url}>{label === "GitHub" ? "View on GitHub" : label + " on GitHub"} <span aria-hidden="true">↗</span></a>
        ))}
        {project.liveUrl && <a class="button" href={project.liveUrl}>Live demo <span aria-hidden="true">↗</span></a>}
      </div>
    </header>

    <section class="section case-section" aria-labelledby="challenge">
      <h2 id="challenge">The challenge</h2>
      <p>{project.challenge}</p>
    </section>
    <section class="section case-section" aria-labelledby="approach">
      <h2 id="approach">How it works</h2>
      <p>{project.approach}</p>
    </section>
    <section class="section case-section" aria-labelledby="highlights">
      <h2 id="highlights">What you can explore</h2>
      <ul class="detail-list">{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
    </section>
    <footer class="section case-section">
      <a class="text-link" href="/#projects"><span aria-hidden="true">←</span> Back to projects</a>
    </footer>
  </main>
</Layout>
