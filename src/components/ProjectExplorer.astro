---
import ProjectCard from "@/components/ProjectCard.astro";
import { profile } from "@/data/profile";
import { projects } from "@/data/projects";

const [featured] = projects;
const filters = ["All", ...new Set(projects.map((project) => project.category))];
---

<section id="projects" class="section" aria-labelledby="projects-heading">
  <div class="section-heading">
    <h2 id="projects-heading">Selected work</h2>
    <a class="text-link" href={profile.github + "?tab=repositories"}>GitHub repos <span aria-hidden="true">↗</span></a>
  </div>

  <article class="featured-project">
    <div class="featured-copy">
      <p class="eyebrow">Featured project</p>
      <h3>{featured.title}</h3>
      <p>{featured.description}</p>
      <a class="text-link" href={`/projects/${featured.id}/`}>Read case study <span aria-hidden="true">↗</span></a>
    </div>
    <div class="workflow" role="img" aria-label="Version control workflow: stage files, commit a snapshot, and sync with AWS S3">
      <div class="workflow-title" aria-hidden="true">
        <span class="window-dots"><i></i><i></i><i></i></span>
        <span>Version control workflow</span>
      </div>
      <ol aria-hidden="true">
        <li><span>01</span><strong>stage</strong><span>working files</span></li>
        <li><span>02</span><strong>commit</strong><span>snapshot</span></li>
        <li><span>03</span><strong>sync</strong><span>AWS S3</span></li>
      </ol>
    </div>
  </article>

  <div class="project-browser" data-project-browser>
    <div class="project-toolbar" data-project-toolbar hidden>
      <div class="filters" role="group" aria-label="Filter projects">
        {filters.map((filter) => <button type="button" data-filter={filter} aria-pressed={filter === "All"}>{filter}</button>)}
      </div>
      <span class="project-count" aria-live="polite" data-project-count>{projects.length} projects</span>
    </div>
    <ul class="project-list" role="list">
      {projects.map((project) => <ProjectCard {project} />)}
    </ul>
  </div>
</section>

<script>
  const explorer = document.querySelector("[data-project-browser]");
  const toolbar = explorer?.querySelector<HTMLElement>("[data-project-toolbar]");
  const counter = explorer?.querySelector("[data-project-count]");
  const buttons = explorer?.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const rows = explorer?.querySelectorAll<HTMLElement>("[data-category]");

  if (toolbar && counter && buttons && rows) {
    toolbar.hidden = false;

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        let count = 0;

        for (const candidate of buttons) {
          candidate.setAttribute("aria-pressed", String(candidate === button));
        }

        for (const row of rows) {
          row.hidden = filter !== "All" && row.dataset.category !== filter;
          if (!row.hidden) count += 1;
        }

        counter.textContent = `${count} projects`;
      });
    }
  }
</script>
