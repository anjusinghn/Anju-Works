---
import type { Project } from "@/data/projects";

type Props = {
  project: Project;
  featured: boolean;
};

const { project, featured } = Astro.props;
---

<article class:list={["project-card", { "project-featured": featured }]}>
  <p class="eyebrow project-category">{project.category}</p>
  <h3>{project.title}</h3>
  <p class="project-description">{project.description}</p>

  <ul class="technologies" aria-label="Technologies" role="list">
    {project.technologies.map((technology) => <li>{technology}</li>)}
  </ul>

  <ul class="project-links" role="list">
    {
      project.repositories.map(({ label, url }) => (
        <li>
          <a
            class="text-link"
            href={url}
            aria-label={project.title + " on GitHub" + (label === "GitHub" ? "" : ", " + label)}
          >
            {label} <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</article>
