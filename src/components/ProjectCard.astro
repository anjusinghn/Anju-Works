---
import type { Project } from "@/data/projects";

interface Props { project: Project }

const { project } = Astro.props;
---

<li class="project-row" data-category={project.category}>
  <details>
    <summary>
      <span class="row-mark" aria-hidden="true">{project.category === "Developer tools" ? "⌘" : "✳"}</span>
      <span class="row-title">{project.title}</span>
      <span class="row-category">{project.category}</span>
      <span class="row-expand" aria-hidden="true"></span>
    </summary>
    <div class="project-details">
      <p>{project.description}</p>
      <ul class="tags" aria-label="Technologies" role="list">
        {project.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
      <div class="project-links">
        <a class="text-link" href={`/projects/${project.id}/`}>Read case study <span aria-hidden="true">↗</span></a>
        {project.liveUrl && <a class="text-link" href={project.liveUrl}>Live demo <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
  </details>
</li>
